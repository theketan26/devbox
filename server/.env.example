# ==============================================================================
# DEV BOX SERVER ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Copy this file to .env in the server directory:
#   cp .env.example .env
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secrets
# (Generate secure 256-bit random strings for production)
JWT_SECRET=devbox-jwt-master-secret-key-super-secure-2026
JWT_REFRESH_SECRET=devbox-jwt-refresh-secret-key-super-secure-2026

# AES-256-GCM Master Encryption Key
# 64-character hex string (32 bytes) used to encrypt/decrypt secrets in the vault
AES_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CLI API Authorization Key
DEVBOX_CLI_MASTER_KEY=devbox-cli-master-key-xyz987

# Automated Cron Health Check Probe Secret
CRON_SECRET=devbox-cron-internal-secret-token

# Master Administrator Authentication Credentials
# (Default demo password is 'admin123')
MASTER_PASSWORD=admin123
# Base32 Secret used for Google Authenticator / TOTP 2FA
MASTER_TOTP_SECRET=JBSWY3DPEHPK3PXP

# WhatsApp Microservice Alerting Bridge (WAHA / whatsapp-web.js)
WHATSAPP_SERVER_URL=http://localhost:3000
WHATSAPP_SERVER_SECRET=48b570db89384a4f5d95132f9539a426
WHATSAPP_RECIPIENT=919876543210@c.us

# Email Incident Alerts (Resend API)
ALERT_EMAIL_RECIPIENT=devops@example.com
RESEND_API_KEY=

# Supabase Storage & Remote Backup (Optional)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
