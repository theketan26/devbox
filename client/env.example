# ==============================================================================
# DEV BOX CLIENT ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Copy this file to .env in the client directory:
#   cp env.example .env
# ==============================================================================

# Backend API Base URL
# Leave empty or set to /api when running locally with Vite proxy (port 5173 -> 5000)
# Set to full URL (e.g. http://localhost:5000/api or https://api.devbox.internal/api) for production deployments
VITE_API_URL=/api

# Application Display Title
VITE_APP_TITLE="Dev Box - Developer Operations Hub"

# Optional: Enable Mock Telemetry Simulation (true/false)
VITE_ENABLE_MOCK_TELEMETRY=true
